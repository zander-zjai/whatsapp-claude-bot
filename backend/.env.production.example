# ------------------------------------------------------------------
# ZJAI WhatsApp Claude Bot — PRODUCTION environment variables
#
# Do NOT commit a real ".env.production" with actual secrets. Set these
# in the Railway dashboard: Project -> Service -> Variables.
# ------------------------------------------------------------------

NODE_ENV=production

# Railway sets PORT automatically — only needed if running this build
# locally to test the production config.
PORT=3000

# --- WhatsApp webhook ---
# Token YOU invent. Enter the SAME string in the Meta Developer Portal
# when configuring the webhook (used to verify GET /webhook).
VERIFY_TOKEN=zjai_webhook_verify_2026

# Meta App Secret (Meta App Dashboard -> Settings -> Basic -> App Secret).
# Used to verify the X-Hub-Signature-256 header on every webhook POST.
# If unset, signature verification is skipped (fine for testing, NOT for
# production).
APP_SECRET=your_meta_app_secret

# --- Admin panel login (used by POST /admin/login) ---
ADMIN_USER=zjai_admin
# Generate a strong password, e.g.:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64'))"
ADMIN_PASS=replace_with_a_strong_password

# Secret used to sign admin JWTs (8h expiry). Generate a 64-char random
# string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_random_string

# --- CORS ---
# Comma-separated list of origins allowed to call this API — your deployed
# admin panel URL(s). Do NOT use "*" in production.
ALLOWED_ORIGINS=https://admin.zjaitechnologies.com

# --- Persistent data directory ---
# clients.json, logs.json, settings.json, error-logs/, and backups/ are all
# read from and written to this directory. On Railway, attach a volume and
# point this at its mount path so data survives redeploys.
DATA_DIR=/data
