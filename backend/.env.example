# ------------------------------------------------------------------
# WhatsApp Claude Bot - environment variables
# Copy this file to ".env" and fill in your own values.
# For deploying to Railway, see .env.production.example instead.
# ------------------------------------------------------------------

# "development" locally, "production" when deployed (enables stricter
# logging format and is checked in a couple of places).
NODE_ENV=development

# Token YOU invent. You type the SAME string into the Meta Developer
# Portal when you configure the webhook. Used to verify GET /webhook.
VERIFY_TOKEN=your_webhook_verify_token

# Meta App Secret (App Dashboard -> Settings -> Basic -> App Secret).
# Used to verify the X-Hub-Signature-256 header on POST /webhook.
# Leave blank locally — signature verification is skipped if unset.
APP_SECRET=

# Port the server listens on.
PORT=3000

# --- Admin panel login (used by POST /admin/login) ---
# Hardcoded credentials for the ZJAI Technologies admin panel.
# Can be changed later from the panel's Settings page (stored in settings.json).
ADMIN_USER=zjai_admin
ADMIN_PASS=your_secure_password

# Secret used to sign admin JWTs (8h expiry). Use a long random string in
# production, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of origins allowed to call this API (your admin
# panel's URL). Use "*" only for local testing. CORS_ORIGIN is still read
# as a fallback if ALLOWED_ORIGINS is unset.
ALLOWED_ORIGINS=http://localhost:5173

# Optional: directory where clients.json/logs.json/settings.json/backups
# are stored. Defaults to this backend/ folder if unset.
DATA_DIR=
